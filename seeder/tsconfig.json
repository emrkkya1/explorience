{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "lib/**/*.ts", "utils/**/*.ts", "clients/**/*.ts", "pipeline/**/*.ts", "config/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
